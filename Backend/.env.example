# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/vendorverse

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cloudinary — required for inventory image upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Comma separated list of origins allowed to call the API with
# credentials. Leave empty when Express serves the built SPA itself.
CORS_ORIGINS=

# Email notifications. Leave SMTP_HOST empty to turn email off entirely —
# in app and live alerts keep working either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VendorVerse <no-reply@vendorverse.app>

# Public base URL, used to build the "View order" link inside emails
APP_URL=http://localhost:3000

# Optional
PORT=3000
NODE_ENV=development
