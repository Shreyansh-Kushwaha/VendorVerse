# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/vendorverse

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cloudinary — required for inventory image upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Comma separated list of origins allowed to call the API with
# credentials. Leave empty when Express serves the built SPA itself.
CORS_ORIGINS=

# Optional
PORT=3000
NODE_ENV=development
